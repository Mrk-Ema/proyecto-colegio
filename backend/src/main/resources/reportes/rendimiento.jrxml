<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="rendimiento"
              language="java"
              pageWidth="595"
              pageHeight="842"
              columnWidth="555"
              leftMargin="20"
              rightMargin="20"
              topMargin="20"
              bottomMargin="20">

    <parameter name="anio" class="java.lang.String"/>
    <parameter name="idGrado" class="java.lang.Integer"/>
    <parameter name="idSeccion" class="java.lang.Integer"/>
    <parameter name="totalEstudiantes" class="java.lang.Integer"/>
    <parameter name="totalCursos" class="java.lang.Integer"/>

    <field name="curso" class="java.lang.String"/>
    <field name="promedio" class="java.math.BigDecimal"/>
    <field name="totalEstudiantes" class="java.lang.Integer"/>
    <field name="estudiante" class="java.lang.String"/>
    <field name="carnet" class="java.lang.String"/>
    <field name="tipo" class="java.lang.String"/>

    <title>
        <band height="50">
            <staticText>
                <reportElement x="0" y="0" width="555" height="25"/>
                <textElement textAlignment="Center"><font size="16" isBold="true"/></textElement>
                <text><![CDATA[REPORTE DE RENDIMIENTO ACADÉMICO]]></text>
            </staticText>
            <textField>
                <reportElement x="0" y="28" width="555" height="18"/>
                <textElement textAlignment="Center"><font size="10"/></textElement>
                <textFieldExpression><![CDATA["Año: " + $P{anio} + "  |  Grado: " + $P{idGrado} + "  |  Sección: " + $P{idSeccion} + "  |  Estudiantes: " + $P{totalEstudiantes} + "  |  Cursos: " + $P{totalCursos}]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <columnHeader>
        <band height="20">
            <staticText><reportElement x="0" y="0" width="200" height="20" mode="Opaque" backcolor="#D9E2F3"/><textElement textAlignment="Center" verticalAlignment="Middle"><font size="9" isBold="true"/></textElement><text><![CDATA[Curso]]></text></staticText>
            <staticText><reportElement x="200" y="0" width="100" height="20" mode="Opaque" backcolor="#D9E2F3"/><textElement textAlignment="Center" verticalAlignment="Middle"><font size="9" isBold="true"/></textElement><text><![CDATA[Promedio]]></text></staticText>
            <staticText><reportElement x="300" y="0" width="100" height="20" mode="Opaque" backcolor="#D9E2F3"/><textElement textAlignment="Center" verticalAlignment="Middle"><font size="9" isBold="true"/></textElement><text><![CDATA[Estudiantes]]></text></staticText>
            <staticText><reportElement x="400" y="0" width="155" height="20" mode="Opaque" backcolor="#D9E2F3"/><textElement textAlignment="Center" verticalAlignment="Middle"><font size="9" isBold="true"/></textElement><text><![CDATA[Mejor promedio]]></text></staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="18">
            <textField><reportElement x="0" y="0" width="200" height="18"/><textElement><font size="9"/></textElement><textFieldExpression><![CDATA[$F{curso} != null ? $F{curso} : ""]]></textFieldExpression></textField>
            <textField pattern="#,##0.00"><reportElement x="200" y="0" width="100" height="18"/><textElement textAlignment="Center"><font size="9"/></textElement><textFieldExpression><![CDATA[$F{promedio}]]></textFieldExpression></textField>
            <textField><reportElement x="300" y="0" width="100" height="18"/><textElement textAlignment="Center"><font size="9"/></textElement><textFieldExpression><![CDATA[$F{totalEstudiantes} != null ? $F{totalEstudiantes} : ""]]></textFieldExpression></textField>
            <textField><reportElement x="400" y="0" width="155" height="18"/><textElement><font size="9"/></textElement><textFieldExpression><![CDATA[$F{estudiante} != null ? $F{estudiante} + " (" + $F{carnet} + ")" : ""]]></textFieldExpression></textField>
        </band>
    </detail>

    <pageFooter>
        <band height="25">
            <textField>
                <reportElement x="0" y="5" width="555" height="20"/>
                <textElement textAlignment="Center"><font size="8" isItalic="true"/></textElement>
                <textFieldExpression><![CDATA["Página " + $V{PAGE_NUMBER} + " de " + $V{PAGE_COUNT}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>
</jasperReport>